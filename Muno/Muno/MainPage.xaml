<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Muno.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Muno"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Muno.Models"
    xmlns:views="using:Muno.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <views:PlaybackGlyphConverter x:Key="PlaybackGlyphConverter" />
        <views:BitDepthVisibilityConverter x:Key="BitDepthVisibilityConverter" />
        <views:VariantStateVisualConverter x:Key="VariantStateVisualConverter" />
    </Page.Resources>

    <Grid AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right"  HorizontalAlignment="Left" HorizontalContentAlignment="Center">
            <CommandBar.PrimaryCommands>

                <AppBarButton
                Icon="OpenFile"
                Label="Open File"
                Command="{x:Bind ViewModel.OpenFileCommand}" />
             
            <AppBarSeparator />

            <AppBarButton
                    Command="{x:Bind ViewModel.PlayPauseCommand}"
                    IsEnabled="{x:Bind ViewModel.HasAudioFile, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8">
                <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource PlaybackGlyphConverter}}" />
            </AppBarButton>
                </CommandBar.PrimaryCommands>
        </CommandBar>

        <Grid Grid.Row="1" Padding="16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>



                <TextBlock
                    Grid.Row="1"
                    Text="{x:Bind ViewModel.PositionText, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8" />

                <Grid Grid.Row="2" Margin="0,0,0,12" ColumnSpacing="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"  Spacing="20">
                        <TextBlock Text="Target loudness" FontSize="22" HorizontalAlignment="Center" />
                        <controls:RadialGauge
                            Minimum="-20"
                            Maximum="0"
                            StepSize="1"
                            TickSpacing="1"
                            IsInteractive="True"
                            Value="{x:Bind ViewModel.TargetLoudness, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="20">
                        <TextBlock Text="Mastering intensity" FontSize="22"  HorizontalAlignment="Center" />
                        <controls:RadialGauge
                            Minimum="0"
                            Maximum="100"
                            StepSize="1"
                            TickSpacing="10"
                            IsInteractive="True"
                            Value="{x:Bind ViewModel.MasteringIntensity, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="20">
                        <TextBlock Text="True peak ceiling" FontSize="22"  HorizontalAlignment="Center" />
                        <controls:RadialGauge
                            Minimum="-6"
                            Maximum="0"
                            StepSize="0.1"
                            TickSpacing="1"
                            IsInteractive="True"
                            ValueStringFormat="N1"
                            Value="{x:Bind ViewModel.TruePeakCeiling, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleSwitch
                        Header="Preserve bass"
                        IsOn="{x:Bind ViewModel.PreserveBass, Mode=TwoWay}" />
                    <Button
                        Grid.Column="1"
                        Content="Master"
                        Command="{x:Bind ViewModel.MasterCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right"
                        Padding="24,8" />
                </Grid>

                <StackPanel Grid.Row="4" Spacing="8">
                    <controls:Segmented
                        ItemsSource="{x:Bind ViewModel.OptimizationAlgorithms}"
                        SelectedItem="{x:Bind ViewModel.SelectedOptimizationAlgorithm, Mode=TwoWay}" />
                    <controls:Segmented
                        ItemsSource="{x:Bind ViewModel.OutputFormats}"
                        SelectedItem="{x:Bind ViewModel.SelectedOutputFormat, Mode=TwoWay}" />
                    <controls:Segmented
                        ItemsSource="{x:Bind ViewModel.BitDepths}"
                        SelectedItem="{x:Bind ViewModel.SelectedBitDepth, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.OutputFormat, Mode=OneWay, Converter={StaticResource BitDepthVisibilityConverter}}" />
                    <controls:Segmented
                        ItemsSource="{x:Bind ViewModel.SampleRates}"
                        SelectedItem="{x:Bind ViewModel.SelectedSampleRate, Mode=TwoWay}" />
                </StackPanel>

                <Grid Grid.Row="0">
                    <views:WaveformView
                        WaveformData="{x:Bind ViewModel.CurrentWaveformData, Mode=OneWay}"
                        PlaybackProgress="{x:Bind ViewModel.PlaybackProgress, Mode=OneWay}"
                        Height="200"
                        SeekRequested="WaveformView_SeekRequested" />

                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Foreground="Red"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Visibility="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}" />

                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="48"
                        Height="48" />
                </Grid>
            </Grid>

            <Border Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Versions" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView
                        x:Name="VariantsListView"
                        ItemsSource="{x:Bind ViewModel.Variants, Mode=OneWay}"
                        SelectionMode="Single"
                        SelectedItem="{x:Bind ViewModel.SelectedVariant, Mode=OneWay}"
                        SelectionChanged="VariantsListView_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="IsEnabled" Value="{Binding CanSelect}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TrackVariant">
                                <Grid Padding="4" HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="4"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind DisplayName}" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                        <TextBlock HorizontalAlignment="Right"
                                                Text="Failed"
                                                Foreground="Red"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind State, Converter={StaticResource VariantStateVisualConverter}, ConverterParameter=Failed}" />
                                        <Button
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            IsEnabled="{x:Bind CanExport, Mode=OneWay}"
                                            ToolTipService.ToolTip="Export">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="WAV" Tag="{x:Bind}" CommandParameter="Wav" Click="ExportMenuFlyoutItem_Click" />
                                                    <MenuFlyoutItem Text="MP3" Tag="{x:Bind}" CommandParameter="Mp3" Click="ExportMenuFlyoutItem_Click" />
                                                    <MenuFlyoutItem Text="AAC" Tag="{x:Bind}" CommandParameter="Aac" Click="ExportMenuFlyoutItem_Click" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                        <ProgressBar
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Grid.Row="1"
                                            Maximum="1000"
                                            Minimum="0"
                                            HorizontalAlignment="Stretch"
                                            Value="{x:Bind Progress, Mode=OneWay}"
                                            Visibility="{x:Bind State, Converter={StaticResource VariantStateVisualConverter}, ConverterParameter=Processing}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
